<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <TextView
            android:id="@+id/dashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/faculty_dashboard"
            android:textColor="@color/dark_gray"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dashboardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/manage_lost_found"
            android:textColor="@color/pink_accent"
            android:textSize="15sp" />

        <Button
            android:id="@+id/addItemButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/pink_primary"
            android:text="@string/add_lost_found_button"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/manageItemsButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/pink_light"
            android:text="@string/manage_items"
            android:textColor="@color/dark_gray"
            android:textStyle="bold" />

        <Button
            android:id="@+id/messagesButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/pink_soft"
            android:text="@string/student_messages"
            android:textColor="@color/dark_gray"
            android:textStyle="bold" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="35dp"
            android:backgroundTint="@color/dark_gray"
            android:text="LOG OUT"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
