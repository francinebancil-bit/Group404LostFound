<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Group404LostFound">

        <!-- WELCOME SCREEN - FIRST SCREEN -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- MAIN SCREEN -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- STUDENT LOGIN -->
        <activity
            android:name=".StudentLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- STUDENT SIGN UP -->
        <activity
            android:name=".StudentSignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- SEARCH -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- VIEW ITEMS -->
        <activity
            android:name=".ItemsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FACULTY LOGIN -->
        <activity
            android:name=".FacultyLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FACULTY DASHBOARD -->
        <activity
            android:name=".FacultyDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ADD ITEM -->
        <activity
            android:name=".AddItemActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MANAGE ITEMS -->
        <activity
            android:name=".ManageItemsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EDIT ITEM -->
        <activity
            android:name=".EditItemActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- STUDENT MESSAGES -->
        <activity
            android:name=".StudentMessagesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FACULTY MESSAGES -->
        <activity
            android:name=".FacultyMessagesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
